# TCAD Agent Configuration

# TCAD运行模式
# simulation: 使用模拟数据 (默认)
# local: 在本地运行TCAD (如果TCAD安装在本机)
# ssh: 通过SSH连接到虚拟机运行TCAD
TCAD_MODE=simulation

# Sentaurus TCAD安装路径 (如果TCAD不在系统PATH中)
SENTAURUS_TCAD_PATH=/path/to/sentaurus/tcad

# 工作目录
TCAD_WORKSPACE=./workspace

# SSH虚拟机配置 (仅当TCAD_MODE=ssh时需要)
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USERNAME=tcad_user
SSH_PASSWORD=your_password
# SSH_PRIVATE_KEY=/path/to/private/key
SSH_REMOTE_DIR=/home/tcad_user/tcad_workspace

# 服务器配置
PORT=3001
NODE_ENV=development
